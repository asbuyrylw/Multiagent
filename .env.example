# Nonprofit Enrichment System - Environment Configuration
# Copy this file to .env and fill in your API keys

# Required: Perplexity API Key
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Optional but Recommended: US Census API Key (FREE)
# Significantly reduces costs for US nonprofits
# Get your key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Optional: Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Database Path
# Path to SQLite database for caching
DATABASE_PATH=nonprofit_cache.db

# Optional: Daily API Budget (USD)
# Maximum daily spending on API calls
DAILY_API_BUDGET=50.0
